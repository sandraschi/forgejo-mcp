# Copy to .env (gitignored) or export in the shell. Profiles can also be
# managed at runtime via forgejo_profile_add / the web companion.
FORGEJO_URL=http://localhost:3000
FORGEJO_TOKEN=
FORGEJO_LABEL=Local

# Backend / frontend ports (must match fleet-start.config.ps1)
WEB_PORT=11133
WEB_HOST=127.0.0.1

# MCP transport for `python -m forgejo_mcp`: stdio (Claude Desktop) or http
MCP_TRANSPORT=stdio
