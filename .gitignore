# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environments
.venv/
venv/
ENV/
env/

# Node / Web Build
node_modules/
dist/
web/dist/
web/node_modules/
web/test-results/
web/playwright-report/
# Playwright run marker if the suite is ever launched from the repo root
test-results/

# Local configuration and credentials
.env
.env.*
!.env.example
.env.profiles.json

# Databases and data
data/
*.db
*.sqlite

# Coverage artifacts (regenerable)
.coverage
coverage.xml
htmlcov/

# OS-specific files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# JetBrains / VSCode
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Fleet backup artifacts
*.bak
*.bak.*

# MCPB staging (build artifact, wiped + recopied on every pack)
mcpb/src/

# MCPB distributables (built artifacts, never commit)
*.mcpb

# Assfix working snapshots (regenerable; committed copy lives in docs/assess-reports/)
reports/
!docs/assess-reports/
